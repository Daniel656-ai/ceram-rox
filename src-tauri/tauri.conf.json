{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CeramRox",
  "version": "0.1.142",
  "identifier": "com.ceramrox.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CeramRox",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Daniel656-ai/ceram-rox/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzMjAwQzgxMzREMUM2RDMKUldUVHh0RTBnUXdnbzB0OTZ5Y3BtZkM5c2JtZGYydU84bFBHUmp6dytEMWFic3RYU01ZcHhJMmMK"
    }
  }
}
